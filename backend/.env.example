# ============================================================
# PriceWatch.pt – Backend environment variables
# Copy to .env and fill in your values
# ============================================================

# App
ENVIRONMENT=development
DEBUG=false

# Database
# Local dev:   postgresql://pricewatch:secret@localhost:5432/pricewatch
# Production:  postgresql://<user>:<pass>@<azure-fqdn>/pricewatch?sslmode=require
DATABASE_URL=postgresql://pricewatch:secret@localhost:5432/pricewatch

# Azure AD B2C
# Tenant name: subdomain of <tenant>.onmicrosoft.com (e.g. pricewatchusers)
B2C_TENANT_NAME=pricewatchusers
# Client ID from Azure AD B2C > App registrations > pricewatch-frontend
B2C_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# User flow name created in Azure AD B2C > User flows
B2C_POLICY_NAME=B2C_1_signupsignin

# Redis
# Local dev:   redis://localhost:6379/0
# Production:  rediss://:<access-key>@<hostname>:6380/0
REDIS_URL=redis://localhost:6379/0

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-api03-...

# Scraping
SCRAPE_CONCURRENCY=5
SCRAPE_DELAY_SECONDS=1.0
