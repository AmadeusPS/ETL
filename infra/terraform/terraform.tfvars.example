# =============================================================================
# PriceWatch.pt – Terraform variables
# Copia este ficheiro para terraform.tfvars e preenche os valores em branco
# NUNCA commites terraform.tfvars (está no .gitignore)
# =============================================================================

# --- Conta Azure (já preenchido) ---
subscription_id = "e29cc6cc-0939-4119-9342-cf8f92a46ac2"
tenant_id       = "be2f2049-1486-41f5-8e62-c2fd99678401"
azure_location  = "West Europe"   # Mais próximo de Portugal

# --- Projeto ---
project     = "pricewatch"
environment = "production"

# --- Base de dados PostgreSQL ---
db_username = "pricewatch"
db_password = "SUBSTITUI_POR_PASSWORD_FORTE"   # mín. 8 chars, 1 maiúscula, 1 número

# --- Azure AD B2C ---
# Passo 1: após `terraform apply` criar o tenant B2C, vai ao portal e regista a app
# Passo 2: copia o Client ID gerado e preenche abaixo
b2c_tenant_name   = "pricewatchpt"              # será pricewatchpt.onmicrosoft.com
b2c_client_id     = "PREENCHER_APOS_CRIAR_B2C"  # App registration > Application (client) ID
b2c_client_secret = "PREENCHER_APOS_CRIAR_B2C"  # App registration > Certificates & secrets
b2c_policy_name   = "B2C_1_signupsignin"

# --- Anthropic ---
anthropic_api_key = "sk-ant-api03-SUBSTITUI_PELA_TUA_CHAVE"
